PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/hariom_portfolio
CLIENT_ORIGIN=http://localhost:5173,https://your-portfolio.vercel.app
JWT_SECRET=replace-with-at-least-32-random-bytes
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# GitHub profile data; token is optional and must remain server-side.
GITHUB_USERNAME=HARIOM45-67
GITHUB_TOKEN=

# One-time admin creation inputs; remove them after running npm run create:admin.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# SMTP is optional locally. Production notifications report their delivery status.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_RECEIVER=admin@example.com

# Configure all three Cloudinary values to enable admin resume uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
